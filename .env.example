# Public. Baked into the static approval page at build time.
# Privy's React SDK requires this value to be exactly 25 characters.
# It is not a secret. Never put the Privy app secret in this file or in CI.
# This example stays a generic placeholder. The public app id for this repo is in the bot template and the CLI default.
NEXT_PUBLIC_PRIVY_APP_ID=REPLACE_WITH_PRIVY_APP_ID

# Optional public Privy app client id, if the dashboard created one.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Defaults to https://auth.privy.io. Override only to point at a documented Privy host.
NEXT_PUBLIC_PRIVY_AUTH_BASE=https://auth.privy.io

# Optional override of the CLI's public app id. Unset uses the built-in default.
# The placeholder string is rejected, so this example leaves the variable unset.
# GROKWALLET_APP_ID=

# Masked secret on the bot host. Encrypts ~/.grokwallet/session.json.
# Never commit a real value.
GROKWALLET_PASSPHRASE=

# Optional public origin for the connector URL printed by login. Default: https://grokwallet.fun
# GROKWALLET_PUBLIC_ORIGIN=https://grokwallet.fun

# Optional overrides. Defaults are public RPCs documented in the README.
GROKWALLET_AUTH_BASE=https://auth.privy.io
GROKWALLET_ETHEREUM_RPC=https://ethereum.publicnode.com
GROKWALLET_BASE_RPC=https://mainnet.base.org
GROKWALLET_ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
GROKWALLET_ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
GROKWALLET_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Optional WalletConnect project id from https://dashboard.reown.com. 32 hex characters.
# The CLI ships a public default. This env var wins over wcProjectId in ~/.grokwallet/config.json, and either overrides that default.
# GROKWALLET_WC_PROJECT_ID=

# GitHub Actions secrets only. Never commit them, and do not put them in this file.
# CLOUDFLARE_API_TOKEN=   required. Account → Cloudflare Pages → Edit
# CLOUDFLARE_ACCOUNT_ID=  required. Account id from the Cloudflare dashboard
# IPFS_PINNING_TOKEN=     optional Pinata JWT. Absent means the publish job skips IPFS
# CLOUDFLARE_PAGES_PROJECT is an optional Actions variable. Default project name: grokwallet
# GROKWALLET_OAUTH_HMAC_KEY is a Cloudflare Pages Production secret, not an Actions secret.
# It signs Connect-card OAuth tokens. Generate with: openssl rand -base64 32
